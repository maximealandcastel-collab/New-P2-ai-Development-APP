+++ b/scripts/prepare-p2p-backend-release.mjs
@@ -0,0 +1,47 @@
+import { execFileSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { createRequire } from 'node:module';
+import { existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, copyFileSync, writeFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// Export only the complete, compiled workspace backend. Never package .env,
+// node_modules, databases, uploaded media or the mobile repo's partial snapshot.
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const backend = path.join(root, 'artifacts/p2p-app-backend');
+for (const file of ['src/app.ts', 'src/server.ts', 'src/routes/routesConfig.ts', 'tsconfig.json', 'package.json']) {
+  if (!existsSync(path.join(backend, file))) throw new Error(`Complete backend required: missing ${file}`);
+}
+const output = path.join(root, 'generated-artifacts/p2p-backend');
+mkdirSync(output, { recursive: true });
+const stage = mkdtempSync(path.join(output, 'release-'));
+const require = createRequire(path.join(backend, 'package.json'));
+const tsc = require.resolve('typescript/bin/tsc');
+execFileSync(process.execPath, [tsc, '--project', path.join(backend, 'tsconfig.json'), '--outDir', path.join(stage, 'dist')], { cwd: backend, stdio: 'inherit' });
+
+function files(dir) {
+  return readdirSync(dir, { withFileTypes: true }).flatMap(entry =>
+    entry.name === '__tests__' ? [] :
+    entry.isDirectory() ? files(path.join(dir, entry.name)) :
+    entry.isFile() ? [path.join(dir, entry.name)] : []);
+}
+const manifest = {
+  format: 1, package: '@workspace/p2p-app-backend',
+  createdAt: new Date().toISOString(),
+  workspaceHead: execFileSync('git', ['rev-parse', 'HEAD'], { cwd: root, encoding: 'utf8' }).trim(),
+  state: 'compiled-not-deployed', files: {},
+};
+for (const source of files(path.join(backend, 'src'))) {
+  const relative = path.relative(backend, source);
+  const target = path.join(stage, relative);
+  mkdirSync(path.dirname(target), { recursive: true });
+  copyFileSync(source, target);
+  manifest.files[relative] = createHash('sha256').update(readFileSync(source)).digest('hex');
+}
+copyFileSync(path.join(backend, 'package.json'), path.join(stage, 'package.json'));
+manifest.files['package.json'] = createHash('sha256').update(readFileSync(path.join(stage, 'package.json'))).digest('hex');
+writeFileSync(path.join(stage, 'RELEASE-MANIFEST.json'), JSON.stringify(manifest, null, 2) + '\n');
+const archive = path.join(output, path.basename(stage) + '.tar.gz');
+execFileSync('tar', ['--exclude=__tests__', '-czf', archive, '-C', stage, '.']);
+console.log(`Compiled complete backend: ${path.relative(root, archive)}`);
+console.log('No credentials included. Not deployed; install dependencies before starting dist/server.js.');
