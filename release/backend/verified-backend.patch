+const {IAPSubscriptionModel}=require(path.join(backend,'dist/modules/iap/iap.model'));
+const {UserModel}=require(path.join(backend,'dist/modules/user/user.model'));
+const {EnterpriseSessionModel}=require(path.join(backend,'dist/modules/enterprise/enterprise-session.model'));
+const {TenantAccessModel}=require(path.join(backend,'dist/modules/tenantAccess/tenantAccess.model'));
+const {bootstrap,selectContext}=require(path.join(backend,'dist/modules/enterprise/enterprise.controller'));
+const apple=require(path.join(backend,'dist/modules/iap/apple-verifier.service'));
+const actualAppleVerifier=apple.verifyAppleTransaction;
+const affiliates=require(path.join(backend,'dist/modules/affiliate/affiliate.service'));
+let credits=0,storeCalls=0,expired=false;
+apple.verifyAppleTransaction=async(_proof,purchaseId)=> {
+  storeCalls++;
+  return {purchaseDate:new Date(Date.now()-1000),
+    expiresDate:new Date(Date.now()+(expired?-1000:86400000)),
+    originalTransactionId:'chain-'+purchaseId.replace(/-renewal$/,'')};
+};
+affiliates.creditAffiliateForPurchase=async()=>{credits++;};
+const {verifyIAPSubscription}=require(path.join(backend,'dist/modules/iap/iap.service'));
+let mongo,dir,userId,otherId;
+const wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));
+before(async()=>{
+  const port=await new Promise(resolve=>{const s=net.createServer();s.listen(0,'127.0.0.1',()=>{const p=s.address().port;s.close(()=>resolve(p));});});
+  dir=mkdtempSync(path.join(tmpdir(),'p2p-iap-test-'));
+  mongo=spawn('mongod',['--dbpath',dir,'--port',String(port),'--bind_ip','127.0.0.1',
+    '--replSet','p2p-iap-tests','--quiet'],{stdio:'ignore'});
+  const direct=new MongoClient(`mongodb://127.0.0.1:${port}/?directConnection=true`,{serverSelectionTimeoutMS:500});
+  let ready=false;
+  for(let i=0;i<40;i++){try{await direct.connect();ready=true;break;}catch{await wait(250);}}
+  assert.ok(ready,'isolated mongod must start');
+  await direct.db('admin').command({replSetInitiate:{_id:'p2p-iap-tests',members:[{_id:0,host:`127.0.0.1:${port}`}]}});
+  await direct.close();
+  await mongoose.connect(`mongodb://127.0.0.1:${port}/iap_tests?replicaSet=p2p-iap-tests`,{serverSelectionTimeoutMS:20000});
+  await IAPSubscriptionModel.init();
+  await EnterpriseSessionModel.init();
+  await TenantAccessModel.init();
+});
+beforeEach(async()=>{
+  await IAPSubscriptionModel.deleteMany({});
+  await UserModel.deleteMany({});
+  await EnterpriseSessionModel.deleteMany({});
+  await TenantAccessModel.deleteMany({});
+  userId=new mongoose.Types.ObjectId();otherId=new mongoose.Types.ObjectId();
+  await UserModel.collection.insertMany([userId,otherId].map(_id=>({
+    _id,email:`${_id}@example.test`,isVerified:true,isDeleted:false,role:'user',subscriptionTier:'free',
+    subscribedTrainer:new mongoose.Types.ObjectId(),
+  })));
+  credits=0;storeCalls=0;expired=false;
+});
+after(async()=>{
+  await mongoose.disconnect();
+  if(mongo&&mongo.exitCode===null){mongo.kill('SIGTERM');await new Promise(resolve=>mongo.once('exit',resolve));}
+  if(dir)rmSync(dir,{recursive:true,force:true});
+});
+test('four store products activate correct access and preserve assigned trainer',async()=>{
+  for(const product of ['p2p_standard_3m','p2p_standard_annual','p2p_pro_3m','p2p_pro_annual']){
+    const result=await verifyIAPSubscription(String(userId),'ios',product,product,'receipt');
