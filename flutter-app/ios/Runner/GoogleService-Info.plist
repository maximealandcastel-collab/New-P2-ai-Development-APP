<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  PLACEHOLDER FILE — replace with the real GoogleService-Info.plist downloaded
  from your Firebase Console before building for TestFlight / App Store.

  Steps:
  1. Go to https://console.firebase.google.com → your P2P FitTech AI project.
  2. Project Settings → Your apps → iOS app (bundle ID: com.p2pfittech.ai).
  3. Click "GoogleService-Info.plist" → Download file.
  4. Replace this file with the downloaded one (keep it in ios/Runner/).
  5. The file must NOT be committed to a public repo (add to .gitignore if needed).
  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
-->
<plist version="1.0">
<dict>
  <key>CLIENT_ID</key>
  <string>REPLACE_WITH_FIREBASE_CLIENT_ID</string>
  <key>REVERSED_CLIENT_ID</key>
  <string>REPLACE_WITH_REVERSED_CLIENT_ID</string>
  <key>API_KEY</key>
  <string>REPLACE_WITH_FIREBASE_IOS_API_KEY</string>
  <key>GCM_SENDER_ID</key>
  <string>REPLACE_WITH_GCM_SENDER_ID</string>
  <key>PLIST_VERSION</key>
  <string>1</string>
  <key>BUNDLE_ID</key>
  <string>com.p2pfittech.ai</string>
  <key>PROJECT_ID</key>
  <string>REPLACE_WITH_FIREBASE_PROJECT_ID</string>
  <key>STORAGE_BUCKET</key>
  <string>REPLACE_WITH_FIREBASE_STORAGE_BUCKET</string>
  <key>IS_ADS_ENABLED</key>
  <false/>
  <key>IS_ANALYTICS_ENABLED</key>
  <false/>
  <key>IS_APPINVITE_ENABLED</key>
  <true/>
  <key>IS_GCM_ENABLED</key>
  <true/>
  <key>IS_SIGNIN_ENABLED</key>
  <true/>
  <key>GOOGLE_APP_ID</key>
  <string>REPLACE_WITH_GOOGLE_APP_ID</string>
</dict>
</plist>
